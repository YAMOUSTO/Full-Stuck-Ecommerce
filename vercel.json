{
  "version": 2,
  "builds": [
    {
      "src": "Frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "main.py" },
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "Frontend/index.html" }
  ]
}